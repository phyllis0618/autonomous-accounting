# --- In-memory demo (default when USE_DATABASE is not true) ---
# Omit DATABASE_URL, or use a prisma+ / proxy URL, to run with preloaded fake data.
# Force demo even with Postgres configured:
# DEMO_MODE=1

DEMO_MODE=0

# --- PostgreSQL + Prisma ---
# USE_DATABASE=true and a normal postgresql:// DATABASE_URL enable Prisma persistence.

USE_DATABASE=false
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/autonomous_accounting?schema=public"

# LLM: leave keys empty to use the built-in mock agent responses
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

LLM_MOCK=0
AUTO_COMMIT_THRESHOLD=0.9
