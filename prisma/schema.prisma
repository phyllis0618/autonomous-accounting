// Autonomous accounting ledger + pipeline trace

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum PipelineStatus {
  RUNNING
  COMMITTED
  HITL_PENDING
  FAILED
}

model Account {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  type      AccountType
  lines     JournalLine[]
  createdAt DateTime    @default(now())
}

model JournalEntry {
  id           String       @id @default(cuid())
  description  String
  sourceRef    String?
  confidence   Float?
  committed    Boolean      @default(false)
  hitlRequired Boolean      @default(false)
  committedAt  DateTime?
  createdAt    DateTime     @default(now())
  lines        JournalLine[]
  pipeline     TransactionPipeline?
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal      @default(0) @db.Decimal(18, 2)
  credit         Decimal      @default(0) @db.Decimal(18, 2)
  memo           String?
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

model TransactionPipeline {
  id             String         @id @default(cuid())
  journalEntryId String?        @unique
  rawInputType   String
  rawInputBlob   String         @db.Text
  status         PipelineStatus @default(RUNNING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  journalEntry   JournalEntry?  @relation(fields: [journalEntryId], references: [id])
  stages         PipelineStage[]

  @@index([status])
}

model PipelineStage {
  id                String              @id @default(cuid())
  pipelineId        String
  stageIndex        Int
  name              String
  outputJson        Json
  principlesApplied String[]
  confidence        Float?
  reasoningTrace    String?             @db.Text
  auditorNotes      String?             @db.Text
  createdAt         DateTime            @default(now())
  pipeline          TransactionPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, stageIndex])
  @@index([pipelineId])
}
